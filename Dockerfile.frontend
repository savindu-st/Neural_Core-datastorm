# React Frontend Dockerfile
FROM node:20-alpine

WORKDIR /app

# Install dependencies
COPY webapp/frontend/package.json webapp/frontend/package-lock.json* ./
RUN npm install

# Copy source code
COPY webapp/frontend/ .

# Build the React app (optional for dev, but good for completeness)
# RUN npm run build

# Start the dev server and expose the port
EXPOSE 3000
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]
